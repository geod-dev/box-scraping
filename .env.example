# Copy to .env (git-ignored) and fill in. Real environment variables override this file.

# Scrape.do API token (https://dashboard.scrape.do). Never commit a real value.
SCRAPEDO_API_KEY=

# PostgreSQL (docker compose exposes the bundled database on port 5433).
DATABASE_URL=postgresql+psycopg://scraper:scraper@localhost:5433/competitor_catalog

# Database used by the automated tests (its schema is dropped and recreated by the tests).
TEST_DATABASE_URL=postgresql+psycopg://scraper:scraper@localhost:5433/competitor_catalog_test

# HTTP API (catalog-scraper api): clients send this key as X-API-Key.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# API_AUTH_DISABLED=true   # local development only
# CORS_ORIGINS=http://localhost:5173
# API_PORT=8000

# Worker (catalog-scraper worker): nothing runs unless requested through the API.
# AUTO_SCHEDULE=false               # true = also enqueue due syncs/refreshes automatically
# WORKER_MAX_CONCURRENT_JOBS=4      # different competitors in parallel (never two on one)

# Optional
# LOG_LEVEL=INFO
# COMPETITOR_CONFIG_DIR=config/competitors
# HTML_ARCHIVE_DIR=scratch/html   # save every fetched page (debugging / new fixtures)
